+// Make room in the encoder K/V cache for `T_new` more frames. A frame only
+// attends to the `audio_swa` frames before it, so frames older than that are
+// dropped and the rest moved to the front. Positions stay absolute (RoPE is
+// applied before a frame is cached) and the mask works on cache slots, so a
+// moved frame means the same as it did. Without this the stream stopped
+// encoding once 15 s of audio (12½ s of speech after the silent lead-in) had
+// been fed, and everything said after that was lost.
+static void vox_stream_make_room(voxtral4b_stream* s, int T_new) {
+    if (s->enc_n_cached + T_new <= s->enc_max_T)
+        return;
+    const auto& hp = s->ctx->model.hparams;
+    const int keep = std::min(s->enc_n_cached, (int)hp.audio_swa - 1);
+    const int drop = s->enc_n_cached - keep;
+    if (drop <= 0)
+        return;
+    const int hd = (int)hp.audio_head_dim;
+    const size_t slice = (size_t)hd * s->enc_max_T; // one head of one layer
+    const size_t n_slices = (size_t)hp.audio_n_heads * hp.audio_n_layers;
+    for (ggml_tensor* t : {s->enc_kv_k, s->enc_kv_v}) {
+        std::vector<float> host;
+        float* base;
+        if (ggml_backend_buffer_is_host(s->enc_kv_buf)) {
+            base = (float*)t->data;
+        } else {
+            host.resize(ggml_nelements(t));
+            ggml_backend_tensor_get(t, host.data(), 0, ggml_nbytes(t));
+            base = host.data();
+        }
+        for (size_t i = 0; i < n_slices; i++)
+            std::memmove(base + i * slice, base + i * slice + (size_t)drop * hd, (size_t)keep * hd * sizeof(float));
+        if (!host.empty())
+            ggml_backend_tensor_set(t, host.data(), 0, ggml_nbytes(t));
+    }
+    s->enc_n_cached = keep;
+}
